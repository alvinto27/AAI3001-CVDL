# Refactor golden: deterministic CPU run (workers 0, fixed seed, plain XuNet no-norm).
# scripts/refactor_golden.py hides the GPU for this run. No V3_RUN_NAME: the name comes from the settings.
QUICK=true
V3_DATA=otf
V3_SOURCE=decode
V3_MODEL=xunet
V3_NORM=none
V3_CLIP_T=3
V3_EPOCHS=1
V3_LIMIT_TRAIN_BATCHES=20
V3_BATCH_SIZE=8
V3_WORKERS=0
V3_EVAL_WORKERS=0
V3_PERSISTENT_WORKERS=off
V3_COMPILE=off
V3_PRIME_NEXT_EPOCH=off
V3_MAIN_THREADS=8
V3_ROCM_CONV1_FIX=false
V3_EXTRA_TESTS=none
