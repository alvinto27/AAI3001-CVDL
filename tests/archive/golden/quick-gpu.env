# Refactor golden: GPU QUICK through scripts/run_notebook.py (6 train / 4 evaluation workers).
# Mixed sources, capped validation, wide model: uses the same code paths as the G4 mixed job at tiny size.
QUICK=true
V3_DATA=otf
V3_SOURCE=decode
V3_MODEL=xunet_wide
V3_WIDTH=4
V3_NORM=none
V3_CLIP_T=3
V3_EPOCHS=2
V3_LR_DROPS=2:0.3
V3_TRAIN_YAML=configs/train-k1to4.yaml
V3_SOURCE_MIX=raise:0.4,lsdir:0.2,alaska:0.4
V3_BATCH_SIZE=8
V3_WORKERS=6
V3_EVAL_WORKERS=4
V3_PERSISTENT_WORKERS=on
V3_COMPILE=off
V3_PRIME_NEXT_EPOCH=on
V3_EXTRA_TESTS=test-bpp1
