!cvdl/models.py
!cvdl/pixels.py
!cvdl/photo_inference.py
!cvdl/cell_diagnostics.py
!cvdl/cell_metrics.py
!cvdl/photo_verdict.py
!cvdl/pipeline/
cvdl/pipeline/**
!cvdl/pipeline/*.py
!LSB-Dataset-Generator/
LSB-Dataset-Generator/**
!LSB-Dataset-Generator/lsb_train_grid.py
!LSB-Dataset-Generator/lsb_source.py
!LSB-Dataset-Generator/lsb_raw.py
!deploy/
deploy/**
!deploy/Dockerfile
!deploy/requirements-core.txt
!deploy/requirements-http.txt
!deploy/run13-rule-c-v1/
deploy/run13-rule-c-v1/**
!deploy/run13-rule-c-v1/deploy.json
!deploy/run13-rule-c-v1/weights.pt
!deploy/run18-rule-c-v1/
deploy/run18-rule-c-v1/**
