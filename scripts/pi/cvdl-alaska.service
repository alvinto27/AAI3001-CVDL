[Unit]
Description=CVDL ALASKA remaining TIFFs (after 13:15 Asia/Singapore)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rpi400/cvdl-jobs
ExecStart=/home/rpi400/hf-env/bin/python /home/rpi400/cvdl-jobs/alaska_download.py
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=78
TimeoutStopSec=15
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
