.venv/
__pycache__/
# checkpoints/ is a notebook's working folder for an active run only; a
# leftover folder here is scratch, never committed.
checkpoints/
Datasets/*
!Datasets/README.md
logs/*
!logs/README.md
# runs/ holds all finished run results; files already tracked in git (the
# frozen v3a/v3b/v3c records and the user's otf/clip3_group notebooks) stay
# tracked even though the folder is ignored for anything new.
runs/
runs/**/*.ckpt
runs/**/logs/tb/
# runs-out/ is the G4 VM's own job output folder (scripts/g4/job*.sh, setup.sh speed).
# It must stay ignored there, or the VM checkout looks dirty and job.sh refuses to update.
runs-out/
