.venv/
__pycache__/
# checkpoints/ is a notebook's working folder for an active run only; a
# leftover folder here is scratch, never committed.
checkpoints/
# runs/ holds all finished run results; files already tracked in git (the
# frozen v3a/v3b/v3c records) stay tracked even though the folder is
# ignored for anything new.
runs/
runs/**/*.ckpt
runs/**/logs/tb/
ImageSets/*
!ImageSets/README.md
Datasets/*
!Datasets/README.md
logs/*
!logs/README.md
